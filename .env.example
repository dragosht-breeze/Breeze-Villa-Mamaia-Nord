# URL public al site-ului
NEXT_PUBLIC_SITE_URL="https://breezevilla.ro"

# Storage JSON folosit în perioada de tranziție. Implicit: ./storage
BREEZE_STORAGE_DIR=
BREEZE_DATA_PROVIDER="json"

# PostgreSQL / Prisma ORM
DATABASE_URL=

# Autentificare — obligatorii înainte de prima pornire în producție
# Secret recomandat: minimum 32 de caractere generate aleatoriu.
BREEZE_AUTH_SECRET=
BREEZE_ADMIN_NAME=
BREEZE_ADMIN_EMAIL=
# Minimum 12 caractere în producție.
BREEZE_ADMIN_PASSWORD=

# E-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL="Breeze Villa <rezervari@breezevilla.ro>"

# NETOPIA Payments
NETOPIA_API_TOKEN=
NETOPIA_PAYMENT_ENDPOINT=
NETOPIA_POS_ID=

# Analiză bundle — activează doar local la nevoie
ANALYZE="false"

# AI
OPENAI_API_KEY=
OPENAI_MODEL="gpt-5.6-luna"

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION="v23.0"
WHATSAPP_TEMPLATE_LANGUAGE="ro"
WHATSAPP_TEMPLATE_PRE_STAY=
WHATSAPP_TEMPLATE_CHECK_IN_DAY=
WHATSAPP_TEMPLATE_IN_STAY=
WHATSAPP_TEMPLATE_PRE_CHECKOUT=
WHATSAPP_TEMPLATE_POST_STAY=

# Guest Automation — păstrează false până când numărul și template-urile Meta sunt gata
GUEST_AUTOMATION_DELIVERY_ENABLED="false"
GUEST_AUTOMATION_CRON_SECRET=
